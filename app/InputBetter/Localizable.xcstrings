{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "  ● 正在播放": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "  ● Playing"
          }
        }
      }
    },
    "%@ · %lld 句。结束后可以在字幕记录窗口里查看、总结和保存。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld lines. After ending, you can review, summarize and save them in the Transcript window."
          }
        }
      }
    },
    "%@ → %@，其他语言 → %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@, other languages → %@"
          }
        }
      }
    },
    "%@ 不是有效的 JSON 对象": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a valid JSON object"
          }
        }
      }
    },
    "%@ 在等你": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs you"
          }
        }
      }
    },
    "%@ 完成了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is done"
          }
        }
      }
    },
    "%@ 尚未下载，请在 设置 › 识别模型 里下载": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't downloaded. Download it in Settings › Speech Models."
          }
        }
      }
    },
    "%@ 尚未配置 API Key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no API key configured"
          }
        }
      }
    },
    "%@ 尚未配置，请在 设置 › 识别模型 里填写 API Key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't set up. Add an API key in Settings › Speech Models."
          }
        }
      }
    },
    "%@ 正被其它程序占用（例如 idf.py monitor）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is in use by another app (e.g. idf.py monitor)"
          }
        }
      }
    },
    "%@ 的写入范围会覆盖受保护分区，已停止": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped: %@ would overwrite a protected partition"
          }
        }
      }
    },
    "%@ 还没有配置密钥": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no key configured"
          }
        }
      }
    },
    "%@（%@）": {
      "shouldTranslate": false
    },
    "%@（不可用）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Unavailable)"
          }
        }
      }
    },
    "%@，在右侧菜单里配置或换一种方式": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Set it up or switch methods in the menu on the right"
